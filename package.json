{
  "name": "code-svn-extension",
  "displayName": "Code SVN",
  "description": "在打开目录内管理 SVN 项目",
  "version": "0.1.3",
  "publisher": "daidaini",
  "repository": {
    "type": "git",
    "url": "https://github.com/daidaini/code-svn-extension.git"
  },
  "private": true,
  "engines": { "vscode": "^1.100.0" },
  "categories": ["SCM Providers"],
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.cjs"
  },
  "contributes": {
    "commands": [
      { "command": "codeSvn.refresh", "title": "SVN：刷新变更", "icon": "$(refresh)" },
      { "command": "codeSvn.update", "title": "SVN：更新管理范围", "icon": "$(sync)" },
      { "command": "codeSvn.showOutput", "title": "SVN：查看查询日志" },
      { "command": "codeSvn.add", "title": "SVN：添加到版本控制", "icon": "$(plus)" },
      { "command": "codeSvn.revert", "title": "SVN：撤销本地变更", "icon": "$(discard)" },
      { "command": "codeSvn.select", "title": "SVN：加入待提交", "icon": "$(add)" },
      { "command": "codeSvn.unselect", "title": "SVN：移出待提交", "icon": "$(remove)" },
      { "command": "codeSvn.commit", "title": "SVN：提交待提交文件", "icon": "$(check)" },
      { "command": "codeSvn.generateDraft", "title": "SVN：生成提交信息草稿", "icon": "$(sparkle)" },
      { "command": "codeSvn.review", "title": "SVN：审查待提交", "icon": "$(eye)" },
      { "command": "codeSvn.reviewAndCommit", "title": "SVN：审查并提交", "icon": "$(check-all)" },
      { "command": "codeSvn.showReviewResults", "title": "SVN：查看审查结果" },
      { "command": "codeSvn.setApiKey", "title": "SVN：配置 AI API Key" },
      { "command": "codeSvn.history", "title": "SVN：查看历史" }
    ],
    "menus": {
      "scm/title": [
        { "command": "codeSvn.refresh", "when": "scmProvider == codeSvn", "group": "navigation" },
        { "command": "codeSvn.update", "when": "scmProvider == codeSvn", "group": "navigation" },
        { "command": "codeSvn.commit", "when": "scmProvider == codeSvn", "group": "navigation" },
        { "command": "codeSvn.generateDraft", "when": "scmProvider == codeSvn", "group": "navigation" },
        { "command": "codeSvn.review", "when": "scmProvider == codeSvn", "group": "navigation" },
        { "command": "codeSvn.reviewAndCommit", "when": "scmProvider == codeSvn", "group": "navigation" }
      ],
      "scm/resourceState/context": [
        { "command": "codeSvn.add", "when": "scmProvider == codeSvn && scmResourceGroup == 未跟踪", "group": "inline" },
        { "command": "codeSvn.revert", "when": "scmProvider == codeSvn && scmResourceGroup != 未跟踪", "group": "inline" },
        { "command": "codeSvn.select", "when": "scmProvider == codeSvn && scmResourceGroup != selected && scmResourceGroup != dependencies", "group": "inline" },
        { "command": "codeSvn.unselect", "when": "scmProvider == codeSvn && scmResourceGroup == selected", "group": "inline" },
        { "command": "codeSvn.history", "when": "scmProvider == codeSvn", "group": "1_history" }
      ],
      "explorer/context": [
        { "command": "codeSvn.history", "when": "resourceScheme == file", "group": "7_svn" }
      ]
    },
    "views": {
      "scm": [ { "id": "codeSvn.reviewResults", "name": "SVN 审查结果" } ]
    },
    "configuration": {
      "title": "Code SVN",
      "properties": {
        "codeSvn.svnPath": {
          "type": "string", "default": "svn", "scope": "machine-overridable",
          "description": "工作区所在环境的 SVN 可执行文件路径。Windows 与 WSL 分别安装和配置 SVN。"
        },
        "codeSvn.ai.baseUrl": {
          "type": "string", "default": "", "scope": "window",
          "description": "OpenAI 兼容模型服务的 API Base URL，例如 https://api.openai.com/v1。留空时不发送生成请求。"
        },
        "codeSvn.ai.model": {
          "type": "string", "default": "", "scope": "window",
          "description": "生成提交信息草稿使用的模型名称。首版仅支持一套有效配置。"
        },
        "codeSvn.ai.timeoutSeconds": {
          "type": "number", "default": 60, "minimum": 1, "maximum": 600, "scope": "window",
          "description": "生成请求的超时秒数。超时后保留原提交信息，由用户手动重试。"
        }
      }
    }
  },
  "dependencies": { "fast-xml-parser": "5.11.2" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "playwright": "1.64.0",
    "typescript": "~5.9.3"
  }
}
